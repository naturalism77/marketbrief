# .env.example — 이 파일을 .env로 복사한 후 실제 키를 입력하세요
# cp .env.example .env

# ── Google Gemini API (무료 티어 사용 가능) ────────────────────
# 발급: https://aistudio.google.com/apikey (Google 계정으로 로그인 후 무료 발급)
GOOGLE_API_KEY=여기에-Gemini-API-키-입력

# ── 이메일 발송 (선택) ─────────────────────────────────────────
# Gmail 사용 시: Google 계정 → 보안 → 앱 비밀번호 (16자리) 발급 필요
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ── Slack 알림 (선택) ──────────────────────────────────────────
# Slack → 채널 설정 → Integrations → Incoming Webhooks → Add
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Telegram 알림 (선택) ────────────────────────────────────────
# 1. @BotFather → /newbot 으로 봇 생성
# 2. 봇을 채널/그룹 관리자로 초대
# 3. https://api.telegram.org/bot{TOKEN}/getUpdates 로 chat_id 확인
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNO-pqrstUVWxyz
TELEGRAM_CHAT_ID=-100123456789
